{
  "name": "inline-email",
  "version": "4.0.1",
  "description": "Compile HTML and CSS into email-safe templates and render them with Handlebars per send. Node library and CLI.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "MIGRATION.md",
    "llms.txt",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "audit": "npm audit --audit-level=high --omit=dev",
    "build": "npm run clean && tsc -p tsconfig.json",
    "check": "npm run lint && npm run build && npm test && npm run examples",
    "clean": "rm -rf dist",
    "coverage:module": "node scripts/module-coverage.js",
    "examples": "npm run build && node scripts/render-examples.js",
    "examples:serve": "npm run examples && node scripts/serve-examples.js",
    "examples:auth": "npm run examples",
    "lint": "eslint .",
    "prepublishOnly": "npm run build && npm test",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:package": "node scripts/check-package.js",
    "test:visual": "playwright test",
    "test:watch": "vitest --coverage.enabled=false"
  },
  "bin": {
    "inline-email": "dist/cli.js"
  },
  "author": "Dan Sabin <dan@freethinking.it>",
  "license": "MIT",
  "dependencies": {
    "handlebars": "^4.7.9",
    "juice": "^12.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.13.0",
    "eslint-plugin-jsdoc": "^65.3.12",
    "globals": "^17.13.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freethinkingit/inline-email.git"
  },
  "keywords": [
    "email",
    "html-email",
    "email-templates",
    "transactional-email",
    "handlebars",
    "juice",
    "css-inlining",
    "responsive-email",
    "cli"
  ],
  "bugs": {
    "url": "https://github.com/freethinkingit/inline-email/issues"
  },
  "homepage": "https://github.com/freethinkingit/inline-email#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.13.0 || >=24",
      "onFail": "warn"
    }
  }
}
